		 $csvResult_upolad_logArray = array();

		 

				$start_cell_row=3;/*skip first 2 heading rows */

				$i=0;

		 

		 if($_FILES['csv']['size'] > 0) 

		 {   

			 	//get the csv file 

				$file = $_FILES['csv']['tmp_name']; 

				$handle = fopen($file,"r"); 

