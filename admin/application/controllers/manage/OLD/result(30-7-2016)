													   'search_service_id'=> $search_service_id);



							/*echo "<pre>";print_r($csv_result_array);exit;	*/					   

						 $csv_upload_status = $this->resultmodel->save_csv_result($csv_result_array);

						 array_push($csvResult_upolad_logArray,$csv_upload_status);

